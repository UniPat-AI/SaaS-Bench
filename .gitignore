# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/

# Local env
.env

# Local results / scratch
results/
results_*/
*.log

# Docker image archives (downloaded separately, see docker/README.md)
docker/images/*.tar
docker/images/*.tar.gz
!docker/images/.gitkeep

# Editor/OS
.DS_Store
.idea/
.vscode/
*.swp

# Internal image-build recipes (fixtures baked into distributed tars; not shipped in the open-source repo)
image-build/

# Internal-only docs (team runbooks; not part of the open-source release)
docs/internal/
IIA/

# Internal working notes and deployment write-ups, kept out of the published repo.
# These are tracked in git history; run `git rm -r --cached backup` once to stop tracking them.
/backup/
