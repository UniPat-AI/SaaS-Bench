# ─── LLM provider ─────────────────────────────────────────────────────────────
# The reference agent (browser-use) talks to any OpenAI-compatible
# chat-completions endpoint. Point these at whichever provider you use.
#
# LLM_PROVIDER is optional: "anthropic" selects the native /v1/messages path,
# anything else (including unset) uses the OpenAI-compatible path. A Claude
# model served behind an OpenAI-compatible gateway needs "openai", not
# "anthropic".
LLM_PROVIDER=openai

LLM_API_KEY=sk-replace-me
LLM_BASE_URL=https://your-provider.example.com/v1
LLM_MODEL=your-model-name

# ─── LLM judge ────────────────────────────────────────────────────────────────
# 23 of the 106 tasks cannot be scored by a database query alone — they judge
# free text or an image — so they call a model as a judge. By default the judge
# reuses LLM_MODEL / LLM_BASE_URL / LLM_API_KEY above, but you can override them 
# here to use a different model or provider.
#
# Uncomment only to send the judge somewhere else. Leaving JUDGE_MODEL set to a
# placeholder is worse than leaving it unset: a non-empty value disables the
# fallback and every judge call fails with an unknown-model error.
#
# Some of those checks send images, so the judge model must accept image input.
JUDGE_MODEL=your-vision-capable-model
JUDGE_BASE_URL=https://your-judge-provider.example.com/v1
JUDGE_API_KEY=sk-replace-me
# JUDGE_REASONING_EFFORT=high

# ─── Optional ─────────────────────────────────────────────────────────────────
# Where per-task transient files live (chrome user-data dirs and agent
# file-system workdirs). Defaults to $TMPDIR/saas_bench. Override if /tmp is
# small or on a slow filesystem.
# SAAS_BENCH_TMP=/tmp/saas_bench